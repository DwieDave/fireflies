#!/bin/bash
# Builds this fork (native views for mods) and installs it as
# /Applications/Herdr.app, where the official app goes, so Dock pins and
# config that point there keep working. Uninstall the official cask first,
# WITHOUT zap: `brew uninstall --cask herdr-app` (its zap trashes
# ~/.config/herdr-app). A build from source never updates itself: to follow a
# new Herdr release, rebase this branch on it and run this again.
#
# Toolchain (the versions Herdr's CI uses): Rust 1.95.0 and Zig 0.16.0, e.g.
#   nix shell nixpkgs#rustup nixpkgs#zig_0_16 -c env RUSTUP_TOOLCHAIN=1.95.0 scripts/install-fork-macos
set -euo pipefail

[[ $(uname -s) == Darwin ]] || { echo 'This installer requires macOS.' >&2; exit 1; }
cd "$(dirname "$0")/.."
cargo build --release

version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
fork=$(git rev-parse --short HEAD)
app=/Applications/Herdr.app
if [[ -d $app ]] && ! /usr/libexec/PlistBuddy -c 'Print :HerdrFork' "$app/Contents/Info.plist" >/dev/null 2>&1; then
  echo "$app is not a fork build (the official app?). Uninstall it first: brew uninstall --cask herdr-app (no --zap)." >&2
  exit 1
fi

mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" "$HOME/.local/bin"
# Replace atomically so installing does not interrupt a running Herdr.
cp target/release/herdr-app "$app/Contents/MacOS/Herdr.new"
mv -f "$app/Contents/MacOS/Herdr.new" "$app/Contents/MacOS/Herdr"
chmod +x "$app/Contents/MacOS/Herdr"
cp assets/icons/Herdr.icns "$app/Contents/Resources/Herdr.icns"

cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Herdr</string>
    <key>CFBundleIdentifier</key><string>dev.herdr.app</string>
    <key>CFBundleName</key><string>Herdr</string>
    <key>CFBundleDisplayName</key><string>Herdr</string>
    <key>CFBundleIconFile</key><string>Herdr</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>$version+$fork</string>
    <key>HerdrFork</key><string>$fork</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in Herdr can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in Herdr can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in Herdr can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict/></dict></plist>
PLIST
# Finder does not inherit a login shell's PATH; hc must still be discoverable.
/usr/libexec/PlistBuddy -c "Add :LSEnvironment:PATH string $HOME/.local/bin:/opt/homebrew/bin:/run/current-system/sw/bin:/usr/bin:/bin" "$app/Contents/Info.plist"
codesign --force --sign - "$app"
ln -sfn "$app/Contents/MacOS/Herdr" "$HOME/.local/bin/herdr-app"
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app"
echo "Installed $app ($version, fork $fork). Quit and reopen Herdr to use it."
