#!/bin/bash
set -euo pipefail

[[ $(uname -s) == Darwin ]] || { echo 'This installer requires macOS.' >&2; exit 1; }
cd "$(dirname "$0")/.."
cargo build --release

app="$HOME/Applications/Fireflies.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" "$HOME/.local/bin"
# Replace atomically so installing does not interrupt a running Fireflies.
cp target/release/herdr-app "$app/Contents/MacOS/Fireflies.new"
mv -f "$app/Contents/MacOS/Fireflies.new" "$app/Contents/MacOS/Fireflies"
chmod +x "$app/Contents/MacOS/Fireflies"
# The firefly icon: Liquid Glass (Assets.car, macOS 26+) and the flat fallback.
cp assets/icons/Fireflies.car "$app/Contents/Resources/Assets.car"
cp assets/icons/Fireflies.icns "$app/Contents/Resources/Fireflies.icns"

cat > "$app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Fireflies</string>
    <key>CFBundleIdentifier</key><string>dev.herdr.app</string>
    <key>CFBundleName</key><string>Fireflies</string>
    <key>CFBundleDisplayName</key><string>Fireflies</string>
    <key>CFBundleIconFile</key><string>Fireflies</string>
    <key>CFBundleIconName</key><string>Fireflies</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.0.1</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in Fireflies can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in Fireflies can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in Fireflies can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict/></dict></plist>
PLIST
# Finder does not inherit a login shell's PATH; hc must still be discoverable.
/usr/libexec/PlistBuddy -c "Add :LSEnvironment:PATH string $HOME/.local/bin:/opt/homebrew/bin:$PATH" "$app/Contents/Info.plist"
codesign --force --sign - "$app"
ln -sfn "$app/Contents/MacOS/Fireflies" "$HOME/.local/bin/herdr-app"
# The app's other name, the one its docs lead with; a `fireflies` that isn't a link is someone else's.
[[ -e "$HOME/.local/bin/fireflies" && ! -L "$HOME/.local/bin/fireflies" ]] || ln -sfn "$app/Contents/MacOS/Fireflies" "$HOME/.local/bin/fireflies"
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app"
echo "Installed $app. Quit and reopen Fireflies to use the new build."
# Earlier runs installed ~/Applications/Herdr.app; Herdr's own installer uses that place too, so it stays.
[[ -d "$HOME/Applications/Herdr.app" ]] && echo "note: ~/Applications/Herdr.app is still there (an earlier just install, or Herdr itself). Remove it if it is an old build." || true
