#!/bin/sh
# Claude Code's PermissionRequest hook for Nocturne's notifications
# (nocturne-notifications): keeps the request Claude Code is about to ask
# (the tool and its input; for AskUserQuestion every question of the block)
# where the Fireflies app reads it, so it can show and answer it exactly.
#
# It never answers: it prints nothing and exits 0, so Claude Code asks in its
# terminal as always. Outside a herdr-core terminal it does nothing at all.
# The record is one file per terminal, replaced by the next request:
#   ${XDG_STATE_HOME:-~/.local/state}/herdr-app/notify/<terminal>.claude.json
id="${HC_TERMINAL_ID:-}"
case "$id" in
  "" | *[!A-Za-z0-9_-]*) cat >/dev/null; exit 0 ;;
esac
dir="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-app/notify"
if mkdir -p "$dir" 2>/dev/null; then
  tmp="$dir/.$id.$$"
  if (umask 077; cat >"$tmp"); then mv -f "$tmp" "$dir/$id.claude.json"; else rm -f "$tmp"; fi
else
  cat >/dev/null
fi
exit 0
