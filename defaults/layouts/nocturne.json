{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "block",
      "content": {
        "mod": "nocturne",
        "props": {
          "role": "sky"
        }
      },
      "size": {
        "px": 252
      },
      "min": 76,
      "max": 440,
      "window_drag": true
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "nocturne",
            "props": {
              "role": "tabs"
            }
          },
          "size": {
            "px": 36
          },
          "window_drag": true
        },
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "header": {
                "content": {
                  "mod": "nocturne",
