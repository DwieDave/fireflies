{
  "name": "fireflies-tools",
  "private": true,
  "type": "module",
  "description": "Developer tools for the mods' TypeScript: the type check, the lint, and the Effect the mods' kit is built on (not shipped from here: the app embeds its bundle).",
  "devDependencies": {
    "@effect/tsgo": "0.69.0",
    "@fireflies/dividers": "workspace:*",
    "@fireflies/editor-route": "workspace:*",
    "@fireflies/envrc": "workspace:*",
    "@fireflies/form-keys": "workspace:*",
    "@fireflies/keyhelp": "workspace:*",
    "@fireflies/kit": "workspace:*",
    "@fireflies/layout-look": "workspace:*",
    "@fireflies/markdown": "workspace:*",
    "@fireflies/menu-place": "workspace:*",
    "@fireflies/scratch": "workspace:*",
    "@fireflies/tones": "workspace:*",
    "@fireflies/toolground": "workspace:*",
    "@fireflies/usage-limits": "workspace:*",
    "@oxlint/plugins": "1.93.0",
    "@types/bun": "1.4.4",
    "effect": "4.1.4",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "defaults/lib/@fireflies/*"
  ]
}
